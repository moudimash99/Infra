  {
   "type": "table",
   "title": "What's firing",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "ALERTS{alertstate=\"firing\"}",
     "legendFormat": "__auto",
     "range": false,
     "instant": true,
     "format": "table"
    }
   ],
   "transformations": [
    {
     "id": "organize",
     "options": {
      "indexByName": {
       "alertname": 0,
       "severity": 1
      },
      "renameByName": {
       "alertname": "Alert",
       "severity": "Severity"
      },
      "excludeByName": {
       "Time": true,
       "Value": true,
       "__name__": true,
       "alertstate": true,
       "cluster": true,
       "job": true,
       "instance": true,
       "endpoint": true,
       "service": true,
       "uid": true,
       "container": true,
       "namespace": false
      }
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "align": "auto",
      "cellOptions": {
       "type": "auto"
      },
      "inspect": false
     },
     "noValue": "Nothing firing"
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Severity"
      },
      "properties": [
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-text"
        }
       },
       {
        "id": "mappings",
        "value": [
         {
          "type": "value",
          "options": {
           "critical": {
            "color": "#d03b3b",
            "index": 0
           },
           "warning": {
            "color": "#fab219",
            "index": 1
           }
          }
         }
        ]
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm",
    "footer": {
     "show": false
    },
    "sortBy": []
   },
