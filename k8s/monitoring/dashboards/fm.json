    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "count(ALERTS{alertstate=\"firing\", alertname=~\"FreeMotion.*\"}) or vector(0)",
     "legendFormat": "__auto",
     "range": false,
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "thresholds": {
      "mode": "absolute",
      "steps": [
