{
 "uid": "pc-jobs",
 "title": "PC jobs",
 "description": "The Windows PC's scheduled jobs, from its reports (every 10 minutes while it is on).",
 "tags": [
  "homelab"
 ],
 "timezone": "browser",
 "editable": true,
 "graphTooltip": 1,
 "schemaVersion": 39,
 "version": 1,
 "refresh": "5m",
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "fiscalYearStartMonth": 0,
 "liveNow": false,
 "links": [
  {
   "title": "Homelab",
   "type": "dashboards",
   "tags": [
    "homelab"
   ],
   "asDropdown": false,
   "includeVars": false,
   "keepTime": false,
   "targetBlank": false
  }
 ],
 "templating": {
  "list": []
 },
 "annotations": {
  "list": []
 },
 "panels": [
  {
   "type": "stat",
   "title": "Last report",
   "description": "Over 20 minutes: the PC is off or asleep, so the rest is its last known state.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "time() - pc_report_timestamp_seconds",
     "legendFormat": "__auto",
     "range": false,
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#0ca30c",
        "value": null
       },
       {
        "color": "#898781",
        "value": 1200
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     },
     "mappings": [],
     "decimals": 0,
     "noValue": "Never: run lab/pc-report/install.ps1"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "orientation": "auto",
    "textMode": "value",
    "colorMode": "value",
    "graphMode": "none",
    "justifyMode": "auto",
    "wideLayout": true,
    "showPercentChange": false,
    "text": {
     "titleSize": 14,
     "valueSize": 30
    }
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 8,
    "h": 4
   },
   "id": 1
  },
  {
   "type": "stat",
   "title": "Tasks failing",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "count(pc_task_ok == 0) or vector(0)",
     "legendFormat": "__auto",
     "range": false,
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#0ca30c",
        "value": null
       },
       {
        "color": "#d03b3b",
        "value": 1
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     },
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "None"
        }
       }
      }
     ]
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "orientation": "auto",
    "textMode": "value",
    "colorMode": "background",
    "graphMode": "none",
    "justifyMode": "auto",
    "wideLayout": true,
    "showPercentChange": false,
    "text": {
     "titleSize": 14,
     "valueSize": 30
    }
   },
   "gridPos": {
    "x": 8,
    "y": 0,
    "w": 8,
    "h": 4
   },
   "id": 2
  },
