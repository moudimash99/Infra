  {
   "type": "table",
   "title": "Scheduled tasks",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "pc_task_ok",
     "legendFormat": "__auto",
     "range": false,
     "instant": true,
     "format": "table"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "pc_task_last_run_timestamp_seconds * 1000",
     "legendFormat": "__auto",
     "range": false,
     "instant": true,
     "format": "table"
    }
   ],
   "transformations": [
    {
     "id": "joinByField",
     "options": {
      "byField": "task",
      "mode": "outer"
     }
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "Time 1": true,
       "Time 2": true,
       "__name__": true,
       "cluster": true,
       "instance": true,
       "job": true,
       "namespace": true,
       "pod": true,
       "app": true,
       "status": true,
       "instance 1": true,
       "instance 2": true,
       "job 1": true,
       "job 2": true,
       "namespace 1": true,
       "namespace 2": true,
       "pod 1": true,
       "pod 2": true,
       "cluster 1": true,
       "cluster 2": true,
       "__name__ 1": true,
       "__name__ 2": true
      },
      "indexByName": {
       "task": 0,
       "Value #A": 1,
       "Value #B": 2,
       "note": 3
      },
      "renameByName": {
       "task": "Task",
       "Value #A": "State",
       "Value #B": "Last run",
       "note": "Note"
      }
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "align": "auto",
      "cellOptions": {
       "type": "auto"
      },
      "inspect": false
     },
     "noValue": "No report yet"
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "State"
      },
      "properties": [
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-text"
        }
       },
       {
        "id": "mappings",
        "value": [
         {
          "type": "value",
          "options": {
           "1": {
            "text": "OK",
            "color": "#0ca30c"
           },
           "0": {
            "text": "Failed",
            "color": "#d03b3b"
           }
          }
         }
        ]
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Last run"
      },
      "properties": [
       {
        "id": "unit",
        "value": "dateTimeFromNow"
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm",
    "footer": {
     "show": false
    },
    "sortBy": []
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 24,
    "h": 10
   },
   "id": 4
  },
