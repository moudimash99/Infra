  {
   "type": "table",
   "title": "Memory by app",
   "description": "Pods on this machine, grouped by app or job (working set: what can't be freed).",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sort_desc(topk(12, sum by (pod_app) (label_replace(container_memory_working_set_bytes{container!=\"\", node=\"$machine\"}, \"pod_app\", \"$1\", \"pod\", \"^(.+?)(-[0-9]{6,}|-[a-f0-9]{8,10})?-[a-z0-9]{5}$\"))))",
     "legendFormat": "{{pod_app}}",
     "range": false,
     "instant": true,
     "format": "table"
    }
   ],
   "transformations": [
    {
     "id": "filterFieldsByName",
     "options": {
      "include": {
       "names": [
        "Value",
        "pod_app"
       ]
      }
     }
    },
    {
     "id": "organize",
     "options": {
      "renameByName": {
       "pod_app": "App"
      },
      "indexByName": {
       "pod_app": 0,
       "Value": 1
      }
     }
    },
    {
     "id": "sortBy",
     "options": {
      "sort": [
       {
        "field": "Value",
        "desc": true
       }
      ]
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "align": "auto",
      "cellOptions": {
       "type": "auto"
      },
      "inspect": false
     },
     "noValue": "Nothing"
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Value"
      },
      "properties": [
       {
        "id": "unit",
        "value": "bytes"
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "gauge",
         "mode": "basic",
         "valueDisplayMode": "text"
        }
       },
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#2a78d6"
        }
       },
       {
        "id": "min",
        "value": 0
       },
       {
        "id": "custom.width",
        "value": 170
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": false,
    "cellHeight": "sm",
    "footer": {
     "show": false
    }
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 11
   },
   "id": 4
  },
